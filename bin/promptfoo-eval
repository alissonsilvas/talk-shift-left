#!/bin/sh

set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

if [ ! -f .env ]; then
    echo "Promptfoo requires .env with OPENROUTER_API_KEY." >&2
    exit 1
fi

set -a
. ./.env
set +a

: "${OPENROUTER_API_KEY:?OPENROUTER_API_KEY is not set in .env}"
export OPENAI_API_KEY="$OPENROUTER_API_KEY"

exec npx --yes promptfoo@0.121.1 eval \
    -c promptfooconfig.yaml \
    --env-file .env \
    --no-cache
