{
    "pre-commit": {
        "enabled": true,
        "actions": [
            {
                "action": "vendor/bin/php-cs-fixer check --diff --config=.php-cs-fixer.dist.php {$STAGED_FILES|of-type:php}",
                "config": {
                    "label": "PHP-CS-Fixer"
                }
            },
            {
                "action": "vendor/bin/phpstan analyse --configuration=phpstan.neon --no-progress --debug {$STAGED_FILES|of-type:php}",
                "config": {
                    "label": "PHPStan"
                }
            },
            {
                "action": "vendor/bin/phpunit --configuration=phpunit.xml",
                "config": {
                    "label": "PHPUnit"
                }
            }
        ]
    },
    "pre-push": {
        "enabled": true,
        "actions": [
            {
                "action": "composer audit --no-interaction",
                "config": {
                    "label": "Composer Audit"
                }
            },
            {
                "action": "vendor/bin/deptrac analyse --config-file=deptrac.yaml",
                "config": {
                    "label": "Deptrac"
                }
            },
            {
                "action": "set -a; . .env; set +a; OPENAI_API_KEY=\"$OPENROUTER_API_KEY\" npx --yes promptfoo@0.121.1 eval -c promptfooconfig.yaml --env-file .env --no-cache",
                "config": {
                    "label": "Promptfoo Account Spec"
                }
            }
        ]
    }
}
